# FriendFlow Client Environment Configuration
# Copy this file to .env.local and populate with your Firebase project credentials

# Firebase Authentication and Cloud Firestore Configuration
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890abcdef

# Optional: Firebase Local Emulator Suite
# Set to "true" to connect to local Firebase Emulators (Auth on 9099, Firestore on 8080)
VITE_USE_FIREBASE_EMULATOR=false

# Optional: Map Tile Provider URL and Attribution
# Default uses standard OpenStreetMap tile servers with required attribution
VITE_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_MAP_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors

# Optional: OSRM Routing Service Endpoint
# Public demo endpoint is for development/light testing only. Use self-hosted or commercial in production.
VITE_OSRM_ROUTING_URL=https://router.project-osrm.org/route/v1/driving
